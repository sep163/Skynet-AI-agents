# claude | ollama
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
# дешёвая модель для демо; для «умного режима» — claude-opus-5-5
CLAUDE_MODEL=claude-haiku-5-5
# low | medium | high
CLAUDE_EFFORT=medium
# локальная модель (офлайн-режим и сравнение в eval)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b-64k
OLLAMA_THINK=false
# локальная транскрибация: tiny | base | small | medium | large-v3
WHISPER_MODEL=small
# оценивать тон моделью (иначе только правила)
EMOTION_LLM=true
SIM_SEED=7
# трассировка Langfuse (необязательно): каждый узел графа, запрос к модели и вызов инструмента
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
